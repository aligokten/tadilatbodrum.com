{
  "hosting": [
    {
      "target": "main",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "rewrites": [
        {
          "source": "/p/**",
          "destination": "/saha/goster.html"
        },
        {
          "source": "/d/**",
          "destination": "/saha/degerlendir.html"
        },
        {
          "source": "/admin",
          "destination": "/admin/index.html"
        },
        {
          "source": "/saha",
          "destination": "/saha/index.html"
        },
        {
          "source": "/saha/**",
          "destination": "/saha/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(js|css|svg|jpg|jpeg|png|webp)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        },
        {
          "source": "/saha/sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "target": "kesif",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "index.html",
        "admin/**",
        "css/**",
        "assets/**",
        "uploads/**",
        "js/main.js",
        "js/firebase-init.js",
        "saha/README.md"
      ],
      "rewrites": [
        {
          "source": "/p/**",
          "destination": "/saha/goster.html"
        },
        {
          "source": "/d/**",
          "destination": "/saha/degerlendir.html"
        },
        {
          "source": "**",
          "destination": "/saha/index.html"
        }
      ],
      "headers": [
        {
          "source": "/saha/sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            },
            {
              "key": "Service-Worker-Allowed",
              "value": "/"
            }
          ]
        },
        {
          "source": "**/*.@(js|css|svg|jpg|jpeg|png|webp)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        }
      ]
    }
  ],
  "functions": {
    "source": "functions",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  }
}
